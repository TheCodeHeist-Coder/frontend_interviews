function FlashCard() {

    const [selectedId, setSelectedId] = useState<number | null>(null);

    function handleCards(id: number){
        setSelectedId(id !== selectedId ? id : null);
    }



    return (
        <div className="flex items-center justify-center">


            <div className="flex gap-4 flex-wrap py-20 pl-30">
                {
                    questions.map(question =>
                        <div key={question.id}
                        onClick={() => handleCards(question.id)}
                            className={`w-96 h-36  flex items-center justify-center cursor-pointer rounded-2xl ${question.id === selectedId ? "bg-red-600" : "bg-green-200"} `}>
                            <p className="text-black font-bold"> {question.id === selectedId ? question.answer : question.question} </p>
                        </div>)
                }

            </div>
        </div>
    )

}




export default App